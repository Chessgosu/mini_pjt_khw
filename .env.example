# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 Git에 올리지 않습니다.
# AI 없이도 일정 계산·화면·검증은 동작합니다 (채팅과 AI 제안만 꺼짐).

# AWS Bedrock (Claude)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명을 쓰는 경우에만
AWS_SESSION_TOKEN=

# Bedrock 모델 ID (교체 가능)
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# AI 호출 제한 (시도당 초, 재시도 횟수)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# LangSmith 트레이스 (Observability)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=batch-schedule-checker
